// Samples for the PrismorAIInventory_CL table. Paste into a Sentinel workbook
// or a hunting query. UserHash is an HMAC, not a username.

// Shadow records by surface.
PrismorAIInventory_CL
| where TimeGenerated > ago(7d)
| where Managed == false and Kind != "diagnostic"
| summarize records = count(), hosts = dcount(HostId) by Surface, Kind
| order by records desc

// New since yesterday.
PrismorAIInventory_CL
| where TimeGenerated > ago(1d)
| summarize arg_max(TimeGenerated, *) by RecordId
| project TimeGenerated, Kind, Name, Product, RiskLevel, EntityKey, HostId

// High and critical risk.
PrismorAIInventory_CL
| where TimeGenerated > ago(7d)
| where RiskLevel in ("high", "critical")
| project TimeGenerated, RiskScore, RiskLevel, Kind, Name, Product, EntityKey, HostId, UserHash

// Copilot Studio agents with no end-user auth.
PrismorAIInventory_CL
| where TimeGenerated > ago(7d)
| where Kind == "lowcode_agent"
| where RiskSignals has "NO_AUTH"
| project TimeGenerated, Name, EnvironmentId, RiskScore, RiskSignals, EntityKey

// MCP servers that are the same product on more than one host (shared group).
PrismorAIInventory_CL
| where TimeGenerated > ago(7d)
| where Kind == "mcp_server"
| summarize hosts = dcount(HostId), names = make_set(Name) by GroupId, EntityKey
| where hosts > 1
| order by hosts desc
