// Scheduled analytics rules. Deploy after main.bicep. Each query is the
// condition; the rule resource wraps it. Severity is the Sentinel alert severity.

// 1. New critical inventory record in the last day.
PrismorAIInventory_CL
| where TimeGenerated > ago(1d)
| where RiskLevel == "critical"
| extend AlertName = "Prismor critical shadow AI"

// 2. New ungoverned Copilot Studio agent.
PrismorAIInventory_CL
| where TimeGenerated > ago(1d)
| where Kind == "lowcode_agent" and Managed == false
| extend AlertName = "Prismor new shadow Copilot Studio agent"

// 3. A model runtime or MCP server bound to every interface.
PrismorAIInventory_CL
| where TimeGenerated > ago(1d)
| where RiskSignals has "PUBLIC_BIND"
| extend AlertName = "Prismor AI listener on a public address"
